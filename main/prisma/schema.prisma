generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskPriority {
  low
  medium
  high

  @@map("task_priority")
}

enum UserRole {
  admin
  member

  @@map("user_role")
}

model Team {
  id    Int    @id @default(autoincrement())
  name  String @unique

  users User[]
  tasks Task[]

  @@map("teams")
}

model User {
  id            Int      @id @default(autoincrement())
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          UserRole @default(member)
  jiraUsername  String?  @unique @map("jira_username")
  teamId        Int?     @map("team_id")
  createdAt     DateTime @default(now()) @map("created_at")

  team          Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignedTasks Task[]   @relation("TaskAssignee")

  @@index([teamId])
  @@map("users")
}

model Sprint {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date

  tasks Task[]

  @@map("sprints")
}

model Epic {
  id   Int    @id @default(autoincrement())
  name String @unique

  tasks Task[]

  @@map("epics")
}

model Task {
  id           Int           @id @default(autoincrement())
  title        String
  description  String?
  storyPoints  Decimal?      @map("story_points") @db.Decimal(4, 1)
  priority     TaskPriority  @default(medium)
  assigneeId   Int?          @map("assignee_id")
  teamId       Int           @map("team_id")
  sprintId     Int?          @map("sprint_id")
  epicId       Int?          @map("epic_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  team     Team    @relation(fields: [teamId], references: [id], onDelete: Restrict)
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  epic     Epic?   @relation(fields: [epicId], references: [id], onDelete: SetNull)

  @@index([sprintId])
  @@index([teamId])
  @@index([assigneeId])
  @@index([priority])
  @@index([epicId])
  @@map("tasks")
}
